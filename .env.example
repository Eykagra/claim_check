# Server-only credentials. Never place these in the Chrome extension.
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
YOU_API_KEY=
DEEPGRAM_API_KEY=

# Role-based routing: each provider is used where it adds the most value.
# Gemini is rate-protected by a 12-second batched extraction cooldown in the extension.
CLAIM_EXTRACTOR_PROVIDER=gemini
CLAIM_EXTRACTOR_MODEL=gemini-3.8-flash
CLAIM_EXTRACTOR_FALLBACK_PROVIDER=mistral
CLAIM_EXTRACTOR_FALLBACK_MODEL=mistral-small-2603

PLANNER_PROVIDER=mistral
PLANNER_MODEL=mistral-medium-3-5
PLANNER_FALLBACK_PROVIDER=openai
PLANNER_FALLBACK_MODEL=gpt-5.4-nano

CRITIC_PROVIDER=openai
CRITIC_MODEL=gpt-5.4-mini
CRITIC_FALLBACK_PROVIDER=mistral
CRITIC_FALLBACK_MODEL=mistral-medium-3-5

# USD per million tokens. Gemini is zero here because this route assumes your free tier.
MODEL_PRICING_JSON={"gemini:gemini-3.8-flash":{"inputPerMillion":0,"outputPerMillion":0},"mistral:mistral-small-2603":{"inputPerMillion":0.15,"outputPerMillion":0.6},"mistral:mistral-medium-3-5":{"inputPerMillion":1.5,"outputPerMillion":7.5},"openai:gpt-5-nano":{"inputPerMillion":0.05,"outputPerMillion":0.4},"openai:gpt-5.4-nano":{"inputPerMillion":0.2,"outputPerMillion":1.25},"openai:gpt-5.4-mini":{"inputPerMillion":0.75,"outputPerMillion":4.5}}

HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*
RUN_DEADLINE_MS=45000
RUN_MAX_TOOL_CALLS=8
RUN_MAX_SEARCH_CALLS=4
RUN_MAX_REPLANS=1
RUN_MAX_COST_USD=0.10
